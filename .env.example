# TypeSafe AI (Jev)。https://console.typesafe.ai/ の API Keys で発行する。
# サーバ側 Route Handler でのみ読む。NEXT_PUBLIC_ を付けないこと（ブラウザへ出さない）。
TYPESAFE_API_KEY=

# 判定器の切り替え。typesafe（既定）= TypeSafe の Jev / local = ローカルの OpenAI 互換サーバ。
# local のときは Jev と同じ質問をローカル LLM に答えさせる（外部送信なし・確率はモデルの自己申告）。
JEV_BACKEND=typesafe
JEV_LOCAL_BASE_URL=http://127.0.0.1:8090
# 空ならサーバが載せている先頭のモデルを使う
JEV_LOCAL_MODEL=
# 拡散モデルでも 1 回 4〜8 秒かかるので、Jev（8 秒）より長めにする
JEV_LOCAL_TIMEOUT_MS=20000

# ローカル LLM（llama.cpp の llama-server、OpenAI 互換）
LLAMA_BASE_URL=http://localhost:8080
LLAMA_MODEL=gemma
# トークンが届かない無音がこの時間続いたらアボート（ハング検知）
LLAMA_IDLE_TIMEOUT_MS=120000

# ローカル文字起こし（whisper.cpp の whisper-server）。`npm run whisper` で 8178 に起動する。
# 8080/8081/8082/8084 は llama-server が使用中のため 8178 を使う。
WHISPER_BASE_URL=http://127.0.0.1:8178
