# docker compose 用の上書き値。`cp .env.docker.example .env` して使う。
# すべて任意。未設定なら docker-compose.yml の既定値が使われる。
#
# 注意: アプリのローカル開発用は .env.local（別物）。compose が読むのは .env。

# ホスト側で公開するポート（既定 8050）。
# 既存の使用済み: 8040 insight-me / 8060 grillme / 8070 transpdf / 8090 namingrule
APP_PORT=8050

# 公開する bind アドレス。既定 127.0.0.1（LAN には Caddy の HTTPS 経由でのみ出す）。
# マイクは HTTPS でしか動かないため、平文での LAN 公開は原則しない。
# 開発用サンプルだけを平文で見せたいときのみ 0.0.0.0 にする。
APP_BIND=127.0.0.1

# 判定器。local = ホストの DiffusionGemma / typesafe = Jev（クラウド・従量課金）
JEV_BACKEND=local
JEV_LOCAL_BASE_URL=http://host.docker.internal:8091
JEV_LOCAL_MODEL=mlx-community/diffusiongemma-26B-A4B-it-bf16
JEV_LOCAL_TIMEOUT_MS=20000

# Jev を使うときだけ設定する。NEXT_PUBLIC_ を付けないこと。
TYPESAFE_API_KEY=

# 生成（gemma）
LLAMA_BASE_URL=http://host.docker.internal:8080
LLAMA_MODEL=gemma-4-12b-it
LLAMA_IDLE_TIMEOUT_MS=120000

# 文字起こし（whisper.cpp）
WHISPER_BASE_URL=http://host.docker.internal:8178
